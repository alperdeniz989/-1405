<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>کتاب من</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eee8dc;
            font-family: Tahoma, Arial, sans-serif;
            color: #222;
        }

        .cover {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .book {
            width: 100%;
            max-width: 700px;
            min-height: 650px;
            background: #fffdf8;
            border-radius: 8px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.18);
            padding: 60px 35px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
        }

        .title {
            margin-top: 100px;
        }

        .title h1 {
            font-size: 42px;
            font-weight: normal;
            margin: 0 0 20px;
        }

        .title p {
            font-size: 20px;
            color: #777;
        }

        .author {
            font-size: 18px;
            margin-bottom: 35px;
        }

        .start {
            display: inline-block;
            padding: 14px 45px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 18px;
            cursor: pointer;
        }

        .start:hover {
            background: #444;
        }

        #reader {
            display: none;
            text-align: right;
        }

        #reader h2 {
            text-align: center;
            font-weight: normal;
            margin-bottom: 35px;
        }

        .text {
            line-height: 2.4;
            font-size: 18px;
        }

        .back {
            margin-top: 40px;
            padding: 12px 30px;
            border: none;
            background: #222;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<div class="cover">

    <div class="book">

        <!-- جلد کتاب -->

        <div id="cover">

            <div class="title">
                <h1>کتاب من</h1>
                <p>یک داستان تازه</p>
            </div>

            <div>
                <div class="author">
                    نویسنده: حسین اقبالیان
                </div>

                <button class="start" onclick="openBook()">
                    شروع مطالعه
                </button>
            </div>

        </div>


        <!-- صفحه مطالعه -->

        <div id="reader">

            <h2>فصل اول</h2>

            <div class="text">

                <p>
                    متن کتاب در این قسمت قرار می‌گیرد.
                </p>

                <p>
                    بعداً متن کامل کتاب را اینجا قرار می‌دهیم.
                </p>

            </div>

            <button class="back" onclick="closeBook()">
                بازگشت به جلد
            </button>

        </div>

    </div>

</div>


<script>

function openBook() {

    document.getElementById("cover").style.display = "none";

    document.getElementById("reader").style.display = "block";

}


function closeBook() {

    document.getElementById("reader").style.display = "none";

    document.getElementById("cover").style.display = "block";

}

</script>

</body>
</html>
