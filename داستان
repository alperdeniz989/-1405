<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>کتاب من</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eee8dc;
            font-family: Tahoma, Arial, sans-serif;
            color: #222;
        }

        .book {
            width: 100%;
            max-width: 750px;
            min-height: 100vh;
            margin: auto;
            background: #fffdf8;
            padding: 35px 25px;
        }

        h1 {
            text-align: center;
            font-weight: normal;
            font-size: 36px;
            margin: 30px 0 10px;
        }

        .author {
            text-align: center;
            color: #777;
            margin-bottom: 50px;
        }

        .menu-title {
            font-size: 22px;
            margin-bottom: 20px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 12px;
        }

        .chapter {
            display: block;
            width: 100%;
            padding: 20px;
            margin: 12px 0;
            background: #f4f0e7;
            border: none;
            border-radius: 8px;
            text-align: right;
            font-family: inherit;
            font-size: 18px;
            cursor: pointer;
        }

        .chapter:hover {
            background: #e8e1d4;
        }

        .reader {
            display: none;
        }

        .reader h2 {
            text-align: center;
            font-weight: normal;
            margin: 25px 0 35px;
        }

        .text {
            font-size: 18px;
            line-height: 2.5;
            text-align: justify;
        }

        .back {
            display: block;
            margin: 40px auto 10px;
            padding: 12px 35px;
            border: none;
            border-radius: 6px;
            background: #222;
            color: white;
            font-family: inherit;
            font-size: 16px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<div class="book">

    <!-- فهرست -->

    <div id="menu">

        <h1>کتاب من</h1>

        <div class="author">
            نویسنده: حسین اقبالیان
        </div>

        <div class="menu-title">
            فهرست مطالب
        </div>

        <button class="chapter" onclick="openChapter(1)">
            فصل اول
        </button>

        <button class="chapter" onclick="openChapter(2)">
            فصل دوم
        </button>

        <button class="chapter" onclick="openChapter(3)">
            فصل سوم
        </button>

    </div>


    <!-- فصل اول -->

    <div class="reader" id="chapter1">

        <h2>فصل اول</h2>

        <div class="text">

            <p>
                متن فصل اول در اینجا قرار می‌گیرد.
            </p>

        </div>

        <button class="back" onclick="backToMenu()">
            بازگشت به فهرست
        </button>

    </div>


    <!-- فصل دوم -->

    <div class="reader" id="chapter2">

        <h2>فصل دوم</h2>

        <div class="text">

            <p>
                متن فصل دوم در اینجا قرار می‌گیرد.
            </p>

        </div>

        <button class="back" onclick="backToMenu()">
            بازگشت به فهرست
        </button>

    </div>


    <!-- فصل سوم -->

    <div class="reader" id="chapter3">

        <h2>فصل سوم</h2>

        <div class="text">

            <p>
                متن فصل سوم در اینجا قرار می‌گیرد.
            </p>

        </div>

        <button class="back" onclick="backToMenu()">
            بازگشت به فهرست
        </button>

    </div>

</div>


<script>

function openChapter(number) {

    document.getElementById("menu").style.display = "none";

    document.getElementById("chapter1").style.display = "none";
    document.getElementById("chapter2").style.display = "none";
    document.getElementById("chapter3").style.display = "none";

    document.getElementById("chapter" + number).style.display = "block";
}


function backToMenu() {

    document.getElementById("chapter1").style.display = "none";
    document.getElementById("chapter2").style.display = "none";
    document.getElementById("chapter3").style.display = "none";

    document.getElementById("menu").style.display = "block";
}

</script>

</body>
</html>
